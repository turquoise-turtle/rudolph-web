/bin/
/dist/
*.zip
bootstrap
.env

# A Go workspace for developing against a local Rudolph checkout (docs/deploy.md); go.mod pins the pushed fork.
go.work
go.work.sum

# Build output (scripts/build.sh)
/build/

# Terraform working directories and state. Environments other than the example are local.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log

# Environments hold the account ID, tenant and client IDs and the domain. new_env.sh also writes a
# .gitignore into each, but a directory made by hand has none.
/deployments/environments/*
!/deployments/environments/example/

# macOS Finder metadata
.DS_Store
